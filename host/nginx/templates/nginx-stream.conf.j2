# Nginx stream configuration for TCP proxying
# Generated by Ansible - do not edit manually
# This file must be included in /etc/nginx/nginx.conf
# The host playbook includes it at top level via: include /etc/nginx/stream.d/stream.conf;

# RabbitMQ AMQP - TCP proxy via NodePort
# External access: <host-ip>:5672 -> {{ nginx_rabbitmq_amqp_upstream }} (NodePort) -> rabbitmq.rabbitmq:5672
# The RabbitMQ service is patched to NodePort 30567 via kustomization overlay
stream {
    # TLS passthrough on 443 (no host-level TLS termination).
    # Routes by SNI to upstream TLS endpoints.
    #
    # Requires: ngx_stream_ssl_preread_module (typically present in nginx-full on Debian/Ubuntu).
    #
    map $ssl_preread_server_name $wapps_tls_upstream {
        # K3s API is TLS on 6443 (NOTE: the certificate presented is K3s' own).
        ~^k3s-api\..+$ {{ nginx_k3s_api_upstream }};

        # Default: send all TLS to ingress-nginx HTTPS NodePort.
        default         {{ nginx_ingress_https_upstream }};
    }

    server {
        listen 443;
        ssl_preread on;
        proxy_pass $wapps_tls_upstream;
        proxy_timeout 3600s;
        proxy_connect_timeout 10s;
        error_log /var/log/nginx/tls-passthrough-443.error.log;
    }

    upstream rabbitmq_amqp {
        server {{ nginx_rabbitmq_amqp_upstream }};
    }

    server {
        listen 5672;
        proxy_pass rabbitmq_amqp;
        proxy_timeout 3600s;  # 1 hour - allows for long-lived AMQP connections with heartbeats
        proxy_connect_timeout 10s;
        error_log /var/log/nginx/rabbitmq-amqp.error.log;
    }

    # SSH gateway (ssh-workspace-proxy or similar) — TCP to the Service NodePort on loopback.
    # Must match the cluster Service spec.ports[].nodePort (here 30222) and the host listen port you expose (2222).
    # Client: ssh -p 2222 user@<host>
    upstream ssh_proxy_nodeport {
        server {{ nginx_ssh_proxy_upstream }};
    }

    server {
        listen 2222;
        proxy_pass ssh_proxy_nodeport;
        proxy_timeout 86400s;
        proxy_connect_timeout 10s;
        error_log /var/log/nginx/ssh-proxy.error.log;
    }
}
